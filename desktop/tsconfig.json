{
  "include": ["src", "electron", "renderer", "test", "vite.config.ts"],
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true, "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true, "esModuleInterop": true, "types": ["node"]
  }
}
